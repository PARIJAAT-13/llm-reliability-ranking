{
  "name": "full_llm_reliability_ranking_study",
  "output_dir": "results/full_study",
  "system_prompt": "You are solving a GAIA benchmark task.\nReturn ONLY the final answer.\nDo not explain your reasoning.\nDo not use markdown.\nOutput exactly the final answer.",


  "models": [
    "ollama:tinyllama:latest",
    "ollama:phi3:mini",
    "ollama:qwen2.5:7b",
    "ollama:mistral:7b",
    "ollama:gemma2:9b",
    "ollama:llama3.1:8b"
  ],
  "benchmarks": [
    "GAIA"

  ],
  "seeds": [42, 100, 2026],
  "repetitions": 3,
  "perturbations": [
    "whitespace",
    "typo",
    "rephrase",
    "wrapper",
    "punctuation"
  ],
  "fault_injection": false,
  "fault_types": [
    "timeout",
    "rate_limit",
    "network",
    "context_truncation"
  ],
  "reliability_weights": {
    "consistency": 0.4,
    "robustness": 0.3,
    "fault_tolerance": 0.3
  },
  "visualization": {
    "output_dir": "paper/figures",
    "formats": ["png", "svg", "pdf"],
    "dpi": 300
  },
  "statistical": {
    "confidence_level": 0.95,
    "bootstrap_iterations": 1000,
    "compute_divergence": true
  },
  "parallel": false,
  "max_workers": 4,
  "matrix_mode": "per_pair"
}
